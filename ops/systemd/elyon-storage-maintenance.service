[Unit]
Description=ELYON local storage retention and safe cleanup
Requires=docker.service
After=docker.service local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/root/elyon
ExecStart=/root/elyon/scripts/ops/prune-local-storage.sh
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=15min
