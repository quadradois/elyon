[Unit]
Description=Check ELYON off-host backup freshness
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=OFFHOST_ENV_FILE=/etc/elyon/offhost-backup.env
ExecStart=/usr/local/libexec/elyon/check-offhost-backup.sh
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/elyon-offhost-backup /var/cache/elyon-restic
TimeoutStartSec=10m

[Install]
WantedBy=multi-user.target
