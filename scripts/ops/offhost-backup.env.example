# Copiar para /etc/elyon/offhost-backup.env com owner root:root e modo 0600.
# Nunca versionar valores reais.

export RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET
export RESTIC_PASSWORD_FILE=/etc/elyon/restic-password
export AWS_ACCESS_KEY_ID=REPLACE_ME
export AWS_SECRET_ACCESS_KEY=REPLACE_ME
export RESTIC_CACHE_DIR=/var/cache/elyon-restic

# Objetivos propostos; instalar somente depois da aprovacao do negocio.
export OFFHOST_RPO_HOURS=6
export OFFHOST_RTO_HOURS=4
export OFFHOST_AGE_GRACE_MINUTES=30

export OFFHOST_LOCAL_BACKUP_CONTAINER=elyon_backup
export OFFHOST_LOCAL_BACKUP_ROOT=/root/elyon/backups
export OFFHOST_EXTRA_PATHS='/root/elyon/.env /root/elyon/secrets'
export OFFHOST_RESTIC_TAG=elyon-postgres
export OFFHOST_KEEP_DAILY=7
export OFFHOST_KEEP_WEEKLY=4
export OFFHOST_KEEP_MONTHLY=6
export OFFHOST_REPOSITORY_CHECK_INTERVAL_HOURS=24
export OFFHOST_RESTORE_IMAGE=pgvector/pgvector:0.8.0-pg15
export OFFHOST_RESTORE_TMPFS_SIZE=6g
export OFFHOST_SOURCE_DB_USER=elyon_user

# Slack: field=text. Discord: field=content.
export OFFHOST_ALERT_WEBHOOK_FIELD=text
export OFFHOST_ALERT_WEBHOOK_URL=
