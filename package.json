{
  "name": "elyon",
  "version": "0.1.0",
  "description": "ELYON - Sistema de Captação Inteligente com IA",
  "private": true,
  "workspaces": [
    "pacotes/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "limpar": "turbo run limpar",
    "verificar": "turbo run verificar",
    "migrar": "cd pacotes/backend && npx prisma migrate dev",
    "migrar:deploy": "cd pacotes/backend && npx prisma migrate deploy",
    "studio": "cd pacotes/backend && npx prisma studio",
    "semear": "cd pacotes/backend && npx prisma db seed"
  },
  "devDependencies": {
    "turbo": "^1.11.0",
    "prettier": "^3.1.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Quadra Dois",
  "license": "UNLICENSED"
}
