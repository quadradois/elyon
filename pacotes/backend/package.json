{
  "name": "@elyon/backend",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "start:worker": "node dist/worker.js",
    "webhook:replay": "node dist/scripts/replay-webhook-inbox.js",
    "geo360:sync": "tsx src/scripts/sincronizar-geo360.ts",
    "geo360:lotes": "tsx src/scripts/sincronizar-geo360-lotes.ts",
    "geo360:aliases": "tsx src/scripts/sincronizar-geo360-aliases.ts",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:baseline": "jest --config jest.baseline.config.js --runInBand --detectOpenHandles",
    "baseline:analyze:synthetic": "tsx src/scripts/analisar-baseline-estados.ts --synthetic",
    "baseline:analyze:readonly": "tsx src/scripts/analisar-baseline-estados.ts",
    "baseline:analyze:prepare": "tsx src/scripts/prepare-baseline-analysis.ts",
    "baseline:analyze:validate": "tsx src/scripts/validate-baseline-analysis.ts",
    "test:security:logs": "jest --runInBand src/lib/__tests__/logger-security.test.ts src/middleware/__tests__/correlation-id.test.ts",
    "test:architecture": "tsx src/scripts/verify-module-boundaries.ts",
    "capacity:prepare": "tsx src/scripts/prepare-capacity-baseline.ts apply",
    "capacity:run": "tsx src/scripts/run-capacity-baseline.ts",
    "capacity:cleanup": "tsx src/scripts/prepare-capacity-baseline.ts cleanup",
    "crypto:inventory": "node dist/scripts/rotacionar-chave-criptografia.js --dry-run",
    "crypto:rotate": "node dist/scripts/rotacionar-chave-criptografia.js --apply",
    "crypto:verify": "node dist/scripts/rotacionar-chave-criptografia.js --verify",
    "test:governanca:release": "bash ./scripts/gov-release-gate.sh",
    "test:governanca:release:full": "bash ./scripts/gov-release-gate.sh --full",
    "test:watch": "jest --watch",
    "migrar": "prisma migrate dev",
    "migrar:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "semear": "tsx prisma/semeadura.ts",
    "limpar": "eslint --fix src/**/*.ts",
    "verificar": "tsc -p tsconfig.build.json --noEmit && eslint src/**/*.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@openai/agents": "^0.5.1",
    "@openai/agents-openai": "^0.5.4",
    "@prisma/client": "^5.7.0",
    "@types/multer": "^2.0.0",
    "@types/papaparse": "^5.5.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "googleapis": "^171.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "openai": "^6.9.1",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "5.7.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.11",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^30.2.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.6",
    "typescript": "^5.3.2"
  },
  "prisma": {
    "seed": "tsx prisma/semeadura.ts"
  }
}
