/**
 * Serviço de integração com Groq
 * 
 * Alternativa gratuita ao OpenAI GPT-4
 * - Limite generoso de requisições
 * - Modelos: Llama 3, Mixtral
 * - Muito rápido (até 10x mais que OpenAI)
 * 
 * @see https://console.groq.com/keys
 */

interface GroqMessage {
  role: 'system' | 'user' | 'assistant';
  content: string;
}

interface GroqResponse {
  id: string;
  object: string;
  created: number;
  model: string;
  choices: Array<{
    index: number;
    message: {
      role: string;
      content: string;
    };
    finish_reason: string;
  }>;
  usage?: {
    prompt_tokens: number;
    completion_tokens: number;
    total_tokens: number;
  };
}

interface GroqConfig {
  temperature?: number;
  maxTokens?: number;
  model?: string;
}

export class GroqClient {
  private apiKey: string;
  private baseUrl = 'https://api.groq.com/openai/v1';
  private defaultModel = 'llama-3.3-70b-versatile'; // Modelo atualizado

  constructor(apiKey?: string) {
    this.apiKey = apiKey || process.env.GROQ_API_KEY || '';
    
    if (!this.apiKey) {
      console.warn('[Groq] ⚠️ GROQ_API_KEY não configurada');
    }
  }

  /**
   * Verifica se o Groq está configurado
   */
  isConfigured(): boolean {
    return !!this.apiKey;
  }

  /**
   * Gera texto com o Groq
   */
  async generateContent(
    prompt: string,
    config: GroqConfig = {}
  ): Promise<string> {
    if (!this.apiKey) {
      throw new Error('GROQ_API_KEY não configurada');
    }

    const url = `${this.baseUrl}/chat/completions`;

    const body = {
      model: config.model || this.defaultModel,
      messages: [
        { role: 'user', content: prompt }
      ],
      temperature: config.temperature ?? 0.1,
      max_tokens: config.maxTokens ?? 8192,
    };

    try {
      console.log('[Groq] 🚀 Enviando requisição...');
      
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${this.apiKey}`,
        },
        body: JSON.stringify(body),
      });

      if (!response.ok) {
        const errorText = await response.text();
        console.error('[Groq] ❌ Erro na API:', response.status, errorText);
        throw new Error(`Groq API error: ${response.status} - ${errorText}`);
      }

      const data = await response.json() as GroqResponse;

      if (!data.choices || data.choices.length === 0) {
        throw new Error('Groq não retornou escolhas');
      }

      const text = data.choices[0].message.content;
      
      if (data.usage) {
        console.log(`[Groq] ✅ Tokens: ${data.usage.total_tokens} (prompt: ${data.usage.prompt_tokens}, resposta: ${data.usage.completion_tokens})`);
      }

      return text;

    } catch (error) {
      console.error('[Groq] ❌ Erro:', error);
      throw error;
    }
  }

  /**
   * Gera JSON estruturado com o Groq
   */
  async generateJSON<T = any>(
    prompt: string,
    config: GroqConfig = {}
  ): Promise<T> {
    const jsonPrompt = `${prompt}

IMPORTANTE: Retorne APENAS JSON válido, sem markdown, sem \`\`\`json, sem texto antes ou depois.`;

    const response = await this.generateContent(jsonPrompt, {
      ...config,
      temperature: config.temperature ?? 0.1,
    });

    // Limpar resposta
    let cleanJson = response.trim();
    
    if (cleanJson.startsWith('```json')) {
      cleanJson = cleanJson.slice(7);
    } else if (cleanJson.startsWith('```')) {
      cleanJson = cleanJson.slice(3);
    }
    
    if (cleanJson.endsWith('```')) {
      cleanJson = cleanJson.slice(0, -3);
    }
    
    cleanJson = cleanJson.trim();

    try {
      return JSON.parse(cleanJson) as T;
    } catch (error) {
      console.error('[Groq] ❌ Erro ao parsear JSON:', cleanJson.substring(0, 200));
      throw new Error(`Falha ao parsear JSON do Groq: ${error}`);
    }
  }
}

// Singleton para uso global
export const groq = new GroqClient();
