# ============================================
# ELYON - Variáveis de Ambiente (PRODUÇÃO)
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env!
# ============================================

# ==========================================
# BANCO DE DADOS
# ==========================================
DB_NAME=elyon
DB_USER=elyon_user
DB_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI

# String de conexão (gerada automaticamente no docker-compose)
DATABASE_URL=postgresql://elyon_user:SENHA@postgres:5432/elyon

# ==========================================
# REDIS
# ==========================================
REDIS_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
REDIS_URL=redis://:SENHA@redis:6379

# ==========================================
# OPENAI
# ==========================================
OPENAI_API_KEY=sk-proj-XXXX
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AUTORIZACAO_VENDA_DOC_URL=
AUTORIZACAO_VENDA_DOC_NOME=modelo_autorizacao_venda.pdf
AUTORIZACAO_VENDA_DOC_CAPTION=Segue o modelo de autorização de venda para você analisar com calma.
OPENAI_ORG_ID=org-XXXX

# ==========================================
# EVOLUTION GO (WhatsApp)
# ==========================================
# EVOLUTION_API_KEY = chave global (gerencia instâncias).
# O token por instância é criado/persistido em sessoes_whatsapp.evolutionToken.
EVOLUTION_API_KEY=CHAVE_GLOBAL_EVOLUTION_GO
EVOLUTION_API_URL=https://diamondgreen.com.br
EVOLUTION_WEBHOOK_SOURCE_RANGE=37.60.254.56/32

# ==========================================
# ASAAS (PAGAMENTOS)
# ==========================================
# SANDBOX: https://sandbox.asaas.com/api/v3
# PRODUÇÃO: https://api.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=SUA_CHAVE_DE_PRODUCAO_ASAAS
ASAAS_WEBHOOK_TOKEN=GERE_TOKEN_EXCLUSIVO_DE_32_A_255_CARACTERES

# Manus assina timestamp + URL publica exata + SHA-256 do corpo original.
MANUS_WEBHOOK_URL=https://api.elyon.ia.br/webhooks/manus
MANUS_WEBHOOK_PUBLIC_KEY=

# ==========================================
# JWT & SEGURANÇA
# ==========================================
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_64_CHARS
JWT_EXPIRES_IN=7d

# Chave mestra AES-256: gere com `openssl rand -base64 32`.
# ENCRYPTION_KEY_ID identifica a versão operacional da chave (ex.: prod-2026-07).
ENCRYPTION_KEY=GERE_COM_OPENSSL_RAND_BASE64_32
ENCRYPTION_KEY_ID=prod-AAAA-MM
# Use somente durante uma rotação controlada e remova após a verificação.
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_ID=
ENCRYPTION_KEY_LEGACY=

# ==========================================
# URLs DA APLICAÇÃO
# ==========================================
FRONTEND_URL=https://crm.elyon.ia.br
BACKEND_URL=https://api.elyon.ia.br

# ==========================================
# AMBIENTE
# ==========================================
NODE_ENV=production
READINESS_TIMEOUT_MS=1500
PORT=3000
TRUST_PROXY_HOPS=1
TZ=America/Sao_Paulo
USAR_ORQUESTRADOR_4_AGENTES=true

# ==========================================
# FEATURE FLAGS — AGENTES (P0 Cockpit)
# ==========================================
AGENT_COCKPIT_ENABLED=true
LEARNING_BANK_ENABLED=false
TEMPORAL_FACTS_ENABLED=false
PAOL_SHADOW_ENABLED=false
PAOL_AB_ENABLED=false
PAOL_AB_TRAFFIC_PERCENT=10
PAOL_EMA_ALPHA=0.2
PAOL_EXPLORATION_BONUS=0.05
MCP_SERVER_ENABLED=false
EXPERIENCE_REPLAY_ENABLED=false
EXPERIENCE_REPLAY_RECENT_HOURS=24
EXPERIENCE_REPLAY_HISTORICAL_DAYS=90
EXPERIENCE_REPLAY_RECENT_SAMPLE=150
EXPERIENCE_REPLAY_HISTORICAL_SAMPLE=120
EXPERIENCE_REPLAY_HISTORICAL_POOL=1200
EXPERIENCE_REPLAY_RECENT_RATE=0.14
EXPERIENCE_REPLAY_HISTORICAL_RATE=0.05
EXPERIENCE_REPLAY_MAX_ADJUSTMENT_PER_PATTERN=0.12
EXPERIENCE_REPLAY_MAX_TOTAL_ADJUSTMENT=1.2
EXPERIENCE_REPLAY_MIN_ABS_ADJUSTMENT=0.02
EXPERIENCE_REPLAY_MAX_PATTERNS=60

# Piloto de agenda: manter false ate aprovar tenant, janela e baseline.
# A ativacao aceita exatamente um UUID de tenant confiavel.
AGENDA_EFFECTS_ENABLED=false
AGENDA_NO_SHOW_ENABLED=false
AGENDA_PILOT_TENANT_ID=
# Cutoff UTC ISO-8601 imutavel durante a execucao do worker.
AGENDA_PILOT_STARTED_AT=
# Obrigatorio e explicito antes de habilitar no-show (1..1440).
AGENDA_NO_SHOW_GRACE_MINUTES=

# ==========================================
# TRAEFIK (Reverse Proxy)
# ==========================================
# Email para certificados Let's Encrypt
ACME_EMAIL=contato@elyon.ia.br

# Autenticação do dashboard Traefik
# Gerar com: htpasswd -nb admin SENHA
TRAEFIK_DASHBOARD_AUTH=admin:$apr1$...

# ==========================================
# AUDIO CONVERTER
# ==========================================
AUDIO_CONVERTER_API_KEY=GERE_UMA_CHAVE_ALEATORIA

# ==========================================
# ASSERTIVA (CPF API) - Opcional
# ==========================================
ASSERTIVA_CLIENT_ID=
ASSERTIVA_CLIENT_SECRET=
ASSERTIVA_API_URL=https://api.assertivasolucoes.com.br

# ==========================================
# GITHUB (AÇÕES/API) - Opcional
# ==========================================
# Token pessoal com acesso ao repositório para leitura de GitHub Actions
# Escopo mínimo recomendado: repo (ou Actions read em fine-grained token)
GITHUB_TOKEN=
