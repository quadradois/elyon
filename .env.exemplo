# ====================================
# BANCO DE DADOS
# ====================================
DB_USER=elyon_user
DB_PASSWORD=SENHA_SUPER_FORTE_AQUI
DATABASE_URL=postgresql://elyon_user:SENHA@localhost:5432/elyon

# ====================================
# REDIS
# ====================================
REDIS_PASSWORD=SENHA_REDIS_FORTE
REDIS_URL=redis://:SENHA_REDIS_FORTE@localhost:6379

# ====================================
# OPENAI
# ====================================
OPENAI_API_KEY=sk-proj-XXXX
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AUTORIZACAO_VENDA_DOC_URL=
AUTORIZACAO_VENDA_DOC_NOME=modelo_autorizacao_venda.pdf
AUTORIZACAO_VENDA_DOC_CAPTION=Segue o modelo de autorização de venda para você analisar com calma.
OPENAI_ORG_ID=org-XXXX

# ====================================
# EVOLUTION GO (WhatsApp)
# ====================================
# EVOLUTION_API_KEY = chave global (gerencia instâncias).
# O token por instância é criado/persistido em sessoes_whatsapp.evolutionToken.
EVOLUTION_API_KEY=CHAVE_GLOBAL_EVOLUTION_GO
EVOLUTION_API_URL=https://diamondgreen.com.br
# IP publico fixo da VPS Evolution Go dedicada, em CIDR de host.
EVOLUTION_WEBHOOK_SOURCE_RANGE=203.0.113.10/32

# ====================================
# ASSERTIVA (CPF API)
# ====================================
ASSERTIVA_CLIENT_ID=
ASSERTIVA_CLIENT_SECRET=
ASSERTIVA_API_URL=https://api.assertivasolucoes.com.br

# ====================================
# N8N (Opcional - Futuro)
# ====================================
N8N_USER=admin
N8N_PASSWORD=SENHA_N8N_FORTE

# ====================================
# JWT & SECURITY
# ====================================
JWT_SECRET=CHAVE_SUPER_SECRETA_64_CHARS
JWT_EXPIRES_IN=7d

# ====================================
# APLICAÇÃO
# ====================================
NODE_ENV=development
READINESS_TIMEOUT_MS=1500
PORT=3000
TRUST_PROXY_HOPS=0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
USAR_ORQUESTRADOR_4_AGENTES=true

# ====================================
# FEATURE FLAGS — AGENTES (P0 Cockpit)
# ====================================
AGENT_COCKPIT_ENABLED=true
LEARNING_BANK_ENABLED=false
TEMPORAL_FACTS_ENABLED=false
PAOL_SHADOW_ENABLED=false
PAOL_AB_ENABLED=false
PAOL_AB_TRAFFIC_PERCENT=10
PAOL_EMA_ALPHA=0.2
PAOL_EXPLORATION_BONUS=0.05
MCP_SERVER_ENABLED=false
EXPERIENCE_REPLAY_ENABLED=false
EXPERIENCE_REPLAY_RECENT_HOURS=24
EXPERIENCE_REPLAY_HISTORICAL_DAYS=90
EXPERIENCE_REPLAY_RECENT_SAMPLE=150
EXPERIENCE_REPLAY_HISTORICAL_SAMPLE=120
EXPERIENCE_REPLAY_HISTORICAL_POOL=1200
EXPERIENCE_REPLAY_RECENT_RATE=0.14
EXPERIENCE_REPLAY_HISTORICAL_RATE=0.05
EXPERIENCE_REPLAY_MAX_ADJUSTMENT_PER_PATTERN=0.12
EXPERIENCE_REPLAY_MAX_TOTAL_ADJUSTMENT=1.2
EXPERIENCE_REPLAY_MIN_ABS_ADJUSTMENT=0.02
EXPERIENCE_REPLAY_MAX_PATTERNS=60

# ====================================
# ASAAS (Gateway de Pagamentos)
# ====================================
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=sua_api_key_aqui
# Token exclusivo do webhook Asaas, diferente da API key (32 a 255 caracteres).
ASAAS_WEBHOOK_TOKEN=GERE_UM_TOKEN_ALEATORIO_COM_32_OU_MAIS_CARACTERES

# URL publica exata registrada no Manus; participa da assinatura RSA-SHA256.
MANUS_WEBHOOK_URL=https://api.exemplo.com/webhooks/manus
# Opcional: chave publica PEM. Sem ela, o backend consulta e cacheia via MANUS_API_KEY.
MANUS_WEBHOOK_PUBLIC_KEY=

# ====================================
# MISC
# ====================================
TZ=America/Sao_Paulo

# ====================================
# GITHUB (AÇÕES/API) - Opcional
# ====================================
# Token pessoal com acesso ao repositório para leitura de GitHub Actions
# Escopo mínimo recomendado: repo (ou Actions read em fine-grained token)
GITHUB_TOKEN=
